# ── Database (required) ─────────────────────────────────────────────
# PostgreSQL connection string. Supabase example shown; any Postgres works.
Database_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ── Gemini API key (required) ───────────────────────────────────────
# Get one at https://aistudio.google.com/apikey (new keys start with "AQ.")
Gemenai_Api_Key=your_gemini_api_key

# ── Optional overrides (uncomment to change; defaults shown) ────────
# Gemini model to use
# GEMINI_MODEL=gemini-flash-lite-latest
# Comma-separated models tried when the primary model returns 429 (quota)
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-flash-latest
# Seconds to wait per Gemini call
# GEMINI_TIMEOUT=15
# JWT signing secret — change this in production!
# JWT_SECRET=change-me-in-production
# Comma-separated origins allowed by CORS
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
